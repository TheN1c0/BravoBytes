# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash


# System Prompt Override (Optional - defaults to internal BravoBytes prompt)
BRAVOBYTES_SYSTEM_PROMPT=

# Cloudflare Turnstile Configuration (Optional for local dev, required for prod bot protection)
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

# CORS Configuration (Set to production domain in Netlify)
ALLOWED_ORIGIN=https://bravo-bytes.com

